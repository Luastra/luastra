{
  "name": "luastra",
  "version": "0.1.0-alpha",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "sh scripts/test-all-local.sh",
    "benchmark:orbit": "node scripts/benchmark-orbit.mjs",
    "audit:orbit:chromium": "node scripts/audit-orbit-chromium.mjs",
    "audit:orbit:firefox": "node scripts/audit-orbit-webdriver.mjs --browser=firefox --port=4202 --driver-port=4450",
    "audit:orbit:safari": "node scripts/audit-orbit-webdriver.mjs --browser=safari --port=4201 --driver-port=4449",
    "audit:luastra-dev:chromium": "node scripts/audit-luastra-dev-chromium.mjs",
    "audit:luastra-dev:firefox": "node scripts/audit-luastra-dev-webdriver.mjs --browser=firefox --port=4211 --driver-port=4461",
    "audit:luastra-dev:safari": "node scripts/audit-luastra-dev-webdriver.mjs --browser=safari --port=4212 --driver-port=4462",
    "audit:luastra-dev:public-baseline": "node scripts/compare-luastra-dev-public-baseline.mjs",
    "audit:luastra-dev:public-baseline:firefox": "node scripts/compare-luastra-dev-public-baseline-webdriver.mjs --browser=firefox --candidate-port=4213 --driver-port=4463",
    "audit:luastra-dev:public-baseline:safari": "node scripts/compare-luastra-dev-public-baseline-webdriver.mjs --browser=safari --candidate-port=4214 --driver-port=4464",
    "docs:check": "node website/scripts/validate-reference.mjs && node website/scripts/validate-reference-code.mjs && node website/scripts/validate-recipes.mjs && node website/scripts/validate-typing-examples.mjs && node website/scripts/validate-example-pages.mjs && node cli/luastra.mjs check --project=website/app/luastra.json && node cli/luastra.mjs test --project=website/app/luastra.json",
    "alpha:audit": "node release/audit-public-candidate.mjs",
    "sdk:release": "node release/build-sdk-release.mjs",
    "runtime:package": "node platform/packaging/package-runtime-sdk.mjs",
    "runtime:archive": "node platform/packaging/build-runtime-archives.mjs"
  },
  "devDependencies": {
    "supabase": "2.114.0"
  }
}
