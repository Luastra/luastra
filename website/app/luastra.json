{
  "schemaVersion": 2,
  "project": {
    "id": "dev.luastra.sdk-reference",
    "entry": "app/main"
  },
  "sdk": {
    "contract": 1
  },
  "web": {
    "title": "Luastra — Build apps like games",
    "description": "Luastra is a Luau-first cross-platform application framework for building web, desktop, and mobile apps with a game-like development loop.",
    "canonicalUrl": "https://luastra.dev/",
    "index": true
  },
  "capabilities": [
    "app.launchurl.get",
    "clipboard.write",
    "navigation.history",
    "storage.get",
    "storage.set",
    "timer.control",
    "ui.render"
  ],
  "modules": [
    {
      "id": "app/main",
      "source": "src/main.luau",
      "dependencies": [
        "app/examples",
        "app/landing",
        "app/reference-data",
        "luastra/host",
        "luastra/navigation",
        "luastra/timer",
        "luastra/ui"
      ]
    },
    {
      "id": "app/examples",
      "source": "src/examples.luau",
      "dependencies": ["luastra/ui"]
    },
    {
      "id": "app/landing",
      "source": "src/landing.luau",
      "dependencies": ["luastra/ui"]
    },
    {
      "id": "app/reference-data",
      "source": "src/reference-data.luau",
      "dependencies": []
    },
    {
      "id": "app/tests/smoke",
      "source": "tests/smoke.luau",
      "dependencies": ["app/main"]
    },
    {
      "id": "app/tests/landing",
      "source": "tests/landing.luau",
      "dependencies": ["app/landing", "luastra/ui"]
    },
    {
      "id": "app/tests/reference-data",
      "source": "tests/reference-data.luau",
      "dependencies": ["app/reference-data"]
    },
    {
      "id": "app/tests/routes",
      "source": "tests/routes.luau",
      "dependencies": ["app/main"]
    },
    {
      "id": "app/tests/preferences",
      "source": "tests/preferences.luau",
      "dependencies": ["app/main"]
    }
  ],
  "tests": [
    "app/tests/smoke",
    "app/tests/landing",
    "app/tests/reference-data",
    "app/tests/routes",
    "app/tests/preferences"
  ]
}
