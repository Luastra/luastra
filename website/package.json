{
  "name": "luastra-sdk-reference",
  "version": "0.4.0-alpha",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-reference.mjs",
    "serve": "node scripts/serve.mjs",
    "reference:generate": "node ./app/scripts/generate-reference-data.mjs",
    "reference:build": "npm run reference:generate && node ./scripts/build-reference-site.mjs && node ./scripts/validate-web-build.mjs",
    "desktop:dev": "npm run validate && npm run reference:build && tauri dev",
