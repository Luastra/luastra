        "app/main"
      ]
    }
  ],
  "assets": [
    { "id": "image/card-back", "source": "assets/images/card-back.png", "mediaType": "image/png" }
  ],
  "tests": [
    "app/tests/smoke",
    "app/tests/game-flow"
  ]
