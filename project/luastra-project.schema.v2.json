{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luastra.dev/schemas/project/v2.json",
  "title": "Luastra project manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "sdk", "capabilities", "modules"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
        "entry": { "$ref": "#/$defs/moduleId" }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": { "entry": { "$ref": "#/$defs/moduleId" } }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract"],
      "properties": {
        "contract": { "const": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$" }
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "mediaType"],
        "properties": {
          "id": { "$ref": "#/$defs/moduleId" },
          "source": { "type": "string", "pattern": "^assets/.+" },
          "mediaType": { "enum": ["audio/mpeg", "audio/mp4", "audio/ogg", "audio/wav", "font/woff2", "image/avif", "image/jpeg", "image/png", "image/webp"] }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "canonicalUrl", "index"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
        "description": { "type": "string", "minLength": 1, "maxLength": 320, "pattern": "\\S" },
        "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "index": { "type": "boolean" }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "handler", "generatedClient", "generatedModule"],
      "properties": {
        "declaration": { "type": "string", "pattern": "^.+\\.json$" },
        "handler": { "type": "string", "pattern": "^.+\\.mjs$" },
        "generatedClient": { "type": "string", "pattern": "^.+\\.luau$" },
        "generatedModule": { "$ref": "#/$defs/moduleId" },
        "authentication": { "enum": ["development", "session"] },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "path"],
          "properties": {
            "provider": { "const": "sqlite" },
            "path": { "type": "string", "pattern": "^[^/].*\\.sqlite$" }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider"],
          "properties": {
            "provider": { "enum": ["local-password", "supabase"] }
          }
        },
        "records": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider"],
            "properties": {
              "provider": { "enum": ["local", "supabase"] },
              "table": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}[a-z0-9]$" },
              "authorization": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["public", "authenticated", "owner"] },
                  "field": { "$ref": "#/$defs/recordField" }
                }
              },
              "equalityFields": { "$ref": "#/$defs/recordFieldList16" },
              "mutableFields": { "$ref": "#/$defs/recordFieldList64" },
              "insertFields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/recordField" }
              },
              "sorts": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 16,
                "propertyNames": { "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$" },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["field", "direction"],
                    "properties": {
                      "field": { "$ref": "#/$defs/recordField" },
                      "direction": { "enum": ["asc", "desc"] }
                    }
                  }
                }
              },
              "defaultSort": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$" },
              "maximumLimit": { "type": "integer", "minimum": 1, "maximum": 128 }
            }
          }
        },
        "content": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "source", "mediaType"],
                "properties": {
                  "id": { "$ref": "#/$defs/moduleId" },
                  "source": { "type": "string", "pattern": "^content/.+" },
                  "mediaType": { "enum": ["audio/mpeg", "audio/mp4", "audio/ogg", "audio/wav", "image/avif", "image/jpeg", "image/png", "image/webp"] }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "provider", "bucket", "path", "mediaType", "bytes", "width", "height"],
                "properties": {
                  "id": { "$ref": "#/$defs/moduleId" },
                  "provider": { "const": "supabase" },
                  "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}[a-z0-9]$" },
                  "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
                  "mediaType": { "enum": ["image/avif", "image/jpeg", "image/png", "image/webp"] },
                  "bytes": { "type": "integer", "minimum": 4, "maximum": 26214400 },
                  "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
                  "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
                }
              }
            ]
          }
        },
        "uploads": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "provider", "mediaTypes", "maximumBytes", "maximumWidth", "maximumHeight"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                  "provider": { "const": "local" },
                  "mediaTypes": { "$ref": "#/$defs/uploadImageMediaTypes" },
                  "maximumBytes": { "type": "integer", "minimum": 14, "maximum": 26214400 },
                  "maximumWidth": { "type": "integer", "minimum": 1, "maximum": 8192 },
                  "maximumHeight": { "type": "integer", "minimum": 1, "maximum": 8192 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "provider", "bucket", "prefix", "mediaTypes", "maximumBytes", "maximumWidth", "maximumHeight"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                  "provider": { "const": "supabase" },
                  "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}[a-z0-9]$" },
                  "prefix": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "mediaTypes": { "$ref": "#/$defs/uploadImageMediaTypes" },
                  "maximumBytes": { "type": "integer", "minimum": 14, "maximum": 26214400 },
                  "maximumWidth": { "type": "integer", "minimum": 1, "maximum": 8192 },
                  "maximumHeight": { "type": "integer", "minimum": 1, "maximum": 8192 }
                }
              }
            ]
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "dependencies"],
        "properties": {
          "id": { "$ref": "#/$defs/moduleId" },
          "source": { "type": "string", "minLength": 1 },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/moduleId" }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/moduleId" }
    }
  },
  "$defs": {
    "uploadImageMediaTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["image/jpeg", "image/png"] }
    },
    "recordField": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
    },
    "recordFieldList16": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/recordField" }
    },
    "recordFieldList64": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/recordField" }
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(/[a-z][a-z0-9_-]*)*$"
    }
  }
}
